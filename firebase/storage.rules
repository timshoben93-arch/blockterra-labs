rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{applicationId}/{fileName} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/octet-stream');
      allow read, update, delete: if false;
    }
  }
}
